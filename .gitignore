node_modules
dist
dist-ssr
*.local
.vite

# What @mvpaint/fontgen writes. Deliberately not committed: an atlas is an application's asset,
# and copying the ones you want out of here into your own font folder is the step that makes
# that true. See packages/fontgen/README.md.
packages/fontgen/out

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# tsc build artifacts
vite.config.d.ts
vite.config.js
*.tsbuildinfo

# The manifest scripts/strip-dev-condition.mjs parks during pack. postpack removes it, so this
# only exists if a pack died halfway - in which case package.json is still the stripped copy and
# neither file should be committed.
package.json.prepack-backup
# This repository's own font library, which @mvpaint/fontgen's npm scripts read. It is a folder
# a developer fills, downloaded rather than authored, and it is not part of the published
# package, so it stays out of the repository.
packages/fontgen/fonts/*.woff2
packages/fontgen/fonts/*.ttf

# Except the four Inter faces the repository itself needs: packages/ttf's self-test and the
# fontgen self-tests parse them, the example app's Runtime TTF scene imports two of them, and
# the atlases committed under packages/example-app/public/fonts/ are generated from them.
# Without these a fresh clone cannot run npm test or npm run dev.
!packages/fontgen/fonts/Inter-400-normal.ttf
!packages/fontgen/fonts/Inter-400-italic.ttf
!packages/fontgen/fonts/Inter-700-normal.ttf
!packages/fontgen/fonts/Inter-700-italic.ttf
