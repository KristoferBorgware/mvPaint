node_modules
dist
dist-ssr
*.local
.vite

# What the font generators write. Deliberately not committed: an atlas is an application's
# asset, and copying the ones you want out of here into your own font folder is the step that
# makes that true. See packages/scripts/textgen/README.md.
packages/scripts/textgen/out

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# tsc build artifacts
vite.config.d.ts
vite.config.js
*.tsbuildinfo

# The manifest scripts/strip-dev-condition.mjs parks during pack. postpack removes it, so this
# only exists if a pack died halfway - in which case package.json is still the stripped copy and
# neither file should be committed.
package.json.prepack-backup
# The generators' input folder is a font library a developer fills, downloaded rather than
# authored, so it stays out of the repository.
packages/scripts/textgen/fonts/*.woff2
packages/scripts/textgen/fonts/*.ttf

# Except the four Inter faces the repository itself needs: packages/ttf's self-test and the
# polygon atlas self-test parse them, the example app's Runtime TTF scene imports two of them,
# and the atlases committed under packages/example-app/public/fonts/ are generated from them.
# Without these a fresh clone cannot run npm test or npm run dev.
!packages/scripts/textgen/fonts/Inter-400-normal.ttf
!packages/scripts/textgen/fonts/Inter-400-italic.ttf
!packages/scripts/textgen/fonts/Inter-700-normal.ttf
!packages/scripts/textgen/fonts/Inter-700-italic.ttf
