{
  "name": "@mvpaint/engine",
  "version": "0.2.2",
  "description": "A 2D scene-graph renderer for the browser, built natively for WebGPU with a WebGL2 fallback.",
  "keywords": [
    "webgpu",
    "webgl2",
    "2d",
    "renderer",
    "scene-graph",
    "canvas",
    "vector",
    "msdf",
    "text-rendering"
  ],
  "license": "MIT",
  "author": "Kristofer Borgware",
  "homepage": "https://github.com/KristoferBorgware/mvPaint#readme",
  "bugs": {
    "url": "https://github.com/KristoferBorgware/mvPaint/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KristoferBorgware/mvPaint.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "development": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-Inter.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/engine",
    "prepublishOnly": "node ../../scripts/strip-dev-condition.mjs assert"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "svgpath": "^2.6.0",
    "@webgpu/types": "^0.1.52"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
