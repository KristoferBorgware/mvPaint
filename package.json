{
  "name": "mvpaint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mvpaint/example-app",
    "build": "npm run build -w @mvpaint/engine && npm run build -w @mvpaint/ttf && npm run build -w @mvpaint/scripts && npm run build -w @mvpaint/example-app",
    "preview": "npm run preview -w @mvpaint/example-app",
    "gen:fonts": "npm run gen:fonts -w @mvpaint/scripts",
    "gen:msdf": "npm run gen:msdf -w @mvpaint/scripts",
    "gen:polygons": "npm run gen:polygons -w @mvpaint/scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
