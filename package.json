{
  "name": "mvpaint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mvpaint/example-app",
    "build": "npm run build -w @mvpaint/engine && npm run build -w @mvpaint/example-app",
    "preview": "npm run preview -w @mvpaint/example-app",
    "gen:fonts": "npm run gen:fonts -w @mvpaint/engine",
    "test": "npm run test -w @mvpaint/engine"
  }
}
